---
interface Props { quote: string; name: string; detail: string; offset?: boolean; }
const { quote, name, detail, offset = false } = Astro.props;
---

<figure class:list={["relative rounded-2xl bg-white p-8 ring-1 ring-petal/60", offset && "md:translate-y-4"]}>
  <span class="absolute right-6 top-4 text-6xl font-bold leading-none text-rose" aria-hidden="true">”</span>
  <blockquote class="relative z-10 text-pretty italic leading-7 text-copy">“{quote}”</blockquote>
  <figcaption class="mt-8 flex items-center gap-3">
    <span class="size-10 rounded-full bg-petal" aria-hidden="true"></span>
    <span>
      <strong class="block text-sm text-ink">{name}</strong>
      <span class="text-xs text-muted">{detail}</span>
    </span>
  </figcaption>
</figure>
