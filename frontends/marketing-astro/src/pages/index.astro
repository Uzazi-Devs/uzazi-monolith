---
const BACKEND = import.meta.env.PUBLIC_BACKEND_URL ?? "http://localhost:8080";
const AUTH = import.meta.env.PUBLIC_AUTH_URL ?? "http://localhost:3000";

let health = "unreachable";
try {
  const r = await fetch(`${BACKEND}/healthz`);
  health = (await r.json()).status;
} catch {
  // backend not up at build time — fine for the marketing page
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>uzazi</title>
  </head>
  <body style="font-family: sans-serif; max-width: 640px; margin: 4rem auto;">
    <h1>uzazi</h1>
    <p>Healthcare, closer to every mother.</p>
    <p>Backend <code>/healthz</code> (checked at build): <b>{health}</b></p>
    <a href={AUTH}>Sign in</a>
  </body>
</html>
