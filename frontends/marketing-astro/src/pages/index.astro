---
import { Image } from "astro:assets";
import motherAndBaby from "../assets/mother-and-baby.jpg";
import growthRitual from "../assets/growth-ritual.jpg";
import Baselayout from "../layouts/Baselayout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Icon from "../components/Icon.astro";
import SectionIntro from "../components/SectionIntro.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import "../styles/global.css";

const AUTH = import.meta.env.PUBLIC_AUTH_URL ?? "http://localhost:3000";

const stats = [
  { value: "7", label: "Day streak", note: "Consistency is growth" },
  { value: "12.4k", label: "Mamas active", note: "Join the sisterhood" },
  { value: "100%", label: "Personalized", note: "Rituals for you" },
];

const testimonials = [
  {
    quote: "Uzazi felt like a warm hug during those lonely 3 AM feedings. The daily rituals kept me grounded when everything felt chaotic.",
    name: "Amara K.",
    detail: "Mama of 3 months",
  },
  {
    quote: "Finding a circle of sisters who understand our cultural traditions made all the difference in my healing process.",
    name: "Zainab O.",
    detail: "New Mama",
  },
  {
    quote: "The garden metaphor is so beautiful. Seeing my mental wellness bloom visually really motivated me to keep checking in.",
    name: "Nia M.",
    detail: "Mama of Twins",
  },
];
---

<Baselayout>
  <script is:inline>document.documentElement.classList.add("js");</script>

  <header class="fixed inset-x-0 top-0 z-40 border-b border-petal/40 bg-canvas/90 backdrop-blur-md">
    <div class="page-shell flex h-16 items-center justify-between">
      <a href="#top" class="flex items-center gap-2 font-bold text-bloom focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bloom" aria-label="Uzazi home">
        <Icon name="flower" class="size-6" />
        <span>Uzazi</span>
      </a>
      <div class="flex min-h-9 items-center gap-1.5 rounded-full bg-bloom px-3.5 text-xs font-semibold text-white" aria-label="Seven day streak">
        <Icon name="flower" class="size-4" />
        <span>7-day streak</span>
      </div>
    </div>
  </header>

  <main id="top" class="garden-dots overflow-hidden pt-16">
    <section class="relative py-14 sm:py-20 lg:py-24">
      <div class="pointer-events-none absolute -right-28 top-2 size-96 rounded-full bg-rose/35 blur-3xl"></div>
      <div class="page-shell grid items-center gap-16 lg:grid-cols-2 lg:gap-14">
        <div class="relative z-10 space-y-7 lg:py-8">
          <div class="inline-flex min-h-9 items-center gap-2 rounded-full border border-petal bg-canvas px-4 text-xs font-medium text-copy">
            <Icon name="heart" class="size-4 text-bloom" />
            <span>Postpartum Support Circle</span>
          </div>
          <h1 class="max-w-[19ch] text-balance text-[clamp(2.75rem,4.5vw,3.5rem)] font-extrabold leading-[1.08] tracking-[-0.04em] text-ink">
            Nurturing the village that nurtures the child.
          </h1>
          <p class="max-w-[46ch] text-pretty text-base leading-7 text-copy sm:text-lg sm:leading-8">
            Uzazi is your gentle companion through early motherhood, designed for the African experience with warmth, ritual, and shared wisdom.
          </p>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
            <ButtonLink href={AUTH} class="sm:px-10">Start Your Journey</ButtonLink>
            <ButtonLink href="#stories" variant="secondary" class="sm:px-10">Meet the Sisters</ButtonLink>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-2xl pb-16 lg:w-[calc(100%+5rem)] lg:pb-10">
          <div class="hero-arch relative aspect-[4/4.15] overflow-hidden bg-soft shadow-[0_18px_45px_rgba(114,36,62,.12)]">
            <Image
              src={motherAndBaby}
              alt="A mother smiles while holding her sleeping newborn in warm morning light."
              widths={[512, 768, 1024]}
              sizes="(max-width: 1024px) 90vw, 52vw"
              class="h-full w-full object-cover object-center transition duration-700 ease-out hover:scale-[1.025]"
              loading="eager"
            />
          </div>
          <aside class="mascot-float absolute bottom-0 left-1/2 flex w-[min(90%,18rem)] -translate-x-1/2 items-start gap-4 rounded-2xl bg-white p-5 shadow-[0_10px_24px_rgba(90,45,60,.13)] ring-1 ring-petal lg:-left-8 lg:translate-x-0" aria-label="Encouragement from Mama Bear">
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-rose text-bloom">
              <Icon name="heart" class="size-5" />
            </span>
            <span>
              <span class="mb-1 block text-[11px] font-semibold italic text-copy">Mama Bear says:</span>
              <span class="block text-sm font-medium leading-5 text-ink">“You’re doing amazing today, mama. Remember to hydrate!”</span>
            </span>
          </aside>
        </div>
      </div>
    </section>

    <section class="relative border-y border-petal/25 bg-soft/90 py-14 sm:py-16" aria-label="Community statistics">
      <svg class="pointer-events-none absolute inset-x-0 top-1/2 h-12 w-full -translate-y-1/2 text-petal/40" viewBox="0 0 1200 48" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 28 Q300 10 600 27 T1200 24" fill="none" stroke="currentColor" stroke-width="1" />
      </svg>
      <div class="page-shell relative grid gap-10 text-center sm:grid-cols-3 sm:gap-0">
        {stats.map((stat, index) => (
          <div class:list={["reveal px-6", index > 0 && "sm:border-l sm:border-petal"]}>
            <strong class="block text-5xl font-bold tracking-[-0.04em] text-bloom">{stat.value}</strong>
            <span class="mt-4 block text-sm font-medium uppercase tracking-[0.08em] text-copy">{stat.label}</span>
            <span class="mt-1 block text-xs text-muted">{stat.note}</span>
          </div>
        ))}
      </div>
    </section>

    <section id="experience" class="section-space bg-white">
      <div class="page-shell">
        <SectionIntro eyebrow="The experience" title="Built for your daily rhythm" />

        <div class="mt-16 grid gap-8 md:grid-cols-12">
          <FeatureCard
            title="Emotional Garden"
            description="Watch your mental wellness bloom. Log your moods to grow a digital garden that rewards your mindfulness."
            icon="sprout"
            class="reveal md:col-span-8"
          >
            <Icon name="sprout" class="absolute -bottom-10 right-5 size-52 text-bloom/5 transition duration-700 group-hover:scale-105 group-hover:text-bloom/10" />
          </FeatureCard>

          <FeatureCard
            title="Sisters Circle"
            description="Secure, curated micro-communities of mothers in your local city or stage."
            icon="people"
            tone="pink"
            class="reveal md:col-span-4"
          />

          <FeatureCard
            title="Daily Rituals"
            description="Two-minute check-ins that guide your healing and bonding through postpartum."
            icon="clock"
            tone="plum"
            class="reveal md:col-span-4"
          />

          <article class="reveal relative grid min-h-72 overflow-hidden rounded-2xl bg-rose md:col-span-8 md:grid-cols-[1.1fr_.9fr]">
            <div class="relative z-10 flex flex-col justify-center space-y-5 p-8 sm:p-10">
              <div class="grid size-12 place-items-center rounded-xl bg-bloom/10 text-bloom">
                <Icon name="shield" class="size-7" />
              </div>
              <h3 class="text-2xl font-medium tracking-[-0.02em] text-plum">Clinical Roots, Cultural Heart</h3>
              <p class="max-w-[38ch] text-lg leading-7 text-bloom">Evidence-based tools translated through the lens of African motherhood rituals.</p>
            </div>
            <Image
              src={growthRitual}
              alt="Hands nurture a young green seedling in a clay pot."
              widths={[512, 768]}
              sizes="(max-width: 768px) 100vw, 35vw"
              class="h-64 w-full object-cover md:h-full"
            />
          </article>
        </div>
      </div>
    </section>

    <section id="stories" class="section-space bg-soft/80">
      <div class="page-shell">
        <SectionIntro eyebrow="Voices from the garden" title="Hear from our Mamas" />
        <div class="mt-16 grid gap-8 md:grid-cols-3">
          {testimonials.map((testimonial, index) => (
            <div class="reveal">
              <TestimonialCard {...testimonial} offset={index === 1} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="join" class="section-space bg-white">
      <div class="page-shell">
        <div class="relative mx-auto max-w-4xl overflow-hidden rounded-2xl bg-soft px-6 py-14 text-center shadow-[0_10px_20px_rgba(45,32,35,.1)] sm:px-12 sm:py-20">
          <Icon name="flower" class="pointer-events-none absolute -right-4 top-3 size-40 rotate-[-12deg] text-bloom/5" />
          <div class="relative mx-auto max-w-2xl">
            <h2 class="text-balance text-4xl font-medium tracking-[-0.03em] text-ink sm:text-5xl">Join the village</h2>
            <p class="mx-auto mt-6 max-w-[58ch] text-pretty leading-7 text-copy sm:text-lg">
              Receive weekly wisdom, ritual reminders, and heartwarming stories from our community of mamas.
            </p>
            <form id="newsletter-form" class="mx-auto mt-8 flex max-w-2xl flex-col gap-3 sm:flex-row">
              <label class="sr-only" for="email">Your email address</label>
              <input id="email" name="email" type="email" autocomplete="email" required placeholder="Your email address" class="min-h-12 flex-1 rounded-full bg-white px-7 text-sm text-ink outline-none ring-1 ring-transparent transition placeholder:text-copy focus:ring-2 focus:ring-bloom" />
              <button type="submit" class="min-h-12 rounded-full bg-bloom px-8 py-3.5 text-sm font-medium text-white shadow-[0_6px_12px_rgba(165,46,90,.16)] transition duration-300 hover:-translate-y-0.5 hover:bg-plum focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bloom active:translate-y-0">Join the Garden</button>
            </form>
            <p id="newsletter-status" class="mt-5 min-h-5 text-xs text-muted" aria-live="polite">We honor your privacy like a sacred space. No spam, ever.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-canvas px-5 py-20 text-center sm:py-24">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-xl font-semibold text-ink">Ready to start your garden?</h2>
        <p class="mt-4 text-copy">Join thousands of mamas finding their peace and village today.</p>
        <ButtonLink href={AUTH} class="mt-8 px-10">Get Started Now</ButtonLink>
      </div>
    </section>
  </main>

  <nav class="fixed inset-x-3 bottom-3 z-40 grid grid-cols-4 rounded-2xl bg-white/95 p-2 shadow-[0_8px_24px_rgba(114,36,62,.14)] ring-1 ring-petal/50 backdrop-blur md:hidden" aria-label="Mobile navigation">
    <a href="#top" class="flex min-h-12 flex-col items-center justify-center rounded-xl bg-rose text-[10px] font-medium text-plum"><Icon name="home" class="size-5" />Home</a>
    <a href="#experience" class="flex min-h-12 flex-col items-center justify-center rounded-xl text-[10px] font-medium text-copy"><Icon name="clock" class="size-5" />Rituals</a>
    <a href="#stories" class="flex min-h-12 flex-col items-center justify-center rounded-xl text-[10px] font-medium text-copy"><Icon name="star" class="size-5" />Stories</a>
    <a href="#join" class="flex min-h-12 flex-col items-center justify-center rounded-xl text-[10px] font-medium text-copy"><Icon name="people" class="size-5" />Village</a>
  </nav>

  <script>
    const revealItems = document.querySelectorAll(".reveal");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -40px" });
    revealItems.forEach((item) => observer.observe(item));

    const form = document.querySelector<HTMLFormElement>("#newsletter-form");
    const status = document.querySelector<HTMLElement>("#newsletter-status");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (status) status.textContent = "Newsletter sign-up is opening soon. Thank you for your interest.";
      form.reset();
    });
  </script>
</Baselayout>
