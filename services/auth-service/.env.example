# Env var names for reference — values are injected via Doppler, not .env files.
# e.g. doppler run -- bun run dev
DATABASE_URL=postgres://uzazi:uzazi@postgres:5432/uzazi?sslmode=disable
BETTER_AUTH_URL=http://localhost:3000
# 32+ byte secret; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-real-secret
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
# Optional OAuth (Google login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
