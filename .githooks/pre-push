#!/bin/sh
# Blocks direct pushes to main. Merge through a pull request instead.
# Enabled per-clone with: git config core.hooksPath .githooks

protected="main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	if [ "$remote_ref" = "refs/heads/$protected" ]; then
		echo "error: direct pushes to '$protected' are blocked." >&2
		echo "Create a branch and open a pull request instead." >&2
		exit 1
	fi
done

exit 0
