# ==============================================================================
# Uzazi Monolith - Local Environment Template
# Copy or use these variables in your .env file or Doppler project.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_USER=uzazi
POSTGRES_PASSWORD=
POSTGRES_DB=uzazi
POSTGRES_PORT=5432
DATABASE_URL=postgres://uzazi:YOUR_POSTGRES_PASSWORD@postgres:5432/uzazi?sslmode=disable

# ------------------------------------------------------------------------------
# Redis Cache & Queue
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Auth Service (BetterAuth / Next.js)
# ------------------------------------------------------------------------------
AUTH_PORT=3000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# Optional Social OAuth Providers for BetterAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Go Backend Modular Monolith
# ------------------------------------------------------------------------------
PORT=8080
BACKEND_PORT=8080
AUTH_JWKS_URL=http://auth-service:3000/api/auth/jwks
AI_PROVIDER=gemma
CORS_ALLOWED_ORIGINS=http://uzazi.localhost,http://localhost:4321,http://app.localhost,http://localhost:3001

# ------------------------------------------------------------------------------
# Marketing Frontend (Astro)
# ------------------------------------------------------------------------------
MARKETING_PORT=4321
PUBLIC_AUTH_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8080
PUBLIC_WAITLIST_FORM_ENDPOINT=http://api.localhost/waitlist

# ------------------------------------------------------------------------------
# Mother-Facing App Frontend (Next.js)
# ------------------------------------------------------------------------------
APP_PORT=3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
